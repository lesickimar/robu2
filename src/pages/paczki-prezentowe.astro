---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import BasketCard from '../components/BasketCard.astro';
import { allPackages, telHref, asset } from '../lib/site';

const packages = allPackages();
---

<BaseLayout
  title="Paczki prezentowe Garwolin"
  description="Paczki i boxy prezentowe ze słodyczy — ROBU2 Garwolin. Na firmę, święta i okazje prywatne."
  path="/paczki-prezentowe"
>
  <Section>
    <p class="text-sm font-bold uppercase tracking-wide text-brand">Prezenty</p>
    <h1 class="mt-2 text-4xl font-extrabold text-ink">Paczki prezentowe</h1>
    <p class="mt-4 max-w-2xl text-muted">
      Boxy i paczki ze słodyczy znanych marek — lekkie, gotowe do wręczenia.
      Idealne na upominki firmowe, święta i okazje rodzinne w Garwolinie i okolicach.
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {packages.map((p) => <BasketCard basket={p} />)}
    </div>

    <div class="mt-12 rounded-3xl bg-brand px-6 py-8 text-white md:px-10">
      <h2 class="text-xl font-extrabold md:text-2xl">Paczka na zamówienie?</h2>
      <p class="mt-2 text-white/85">
        Podaj budżet, okazję i preferencje — przygotujemy propozycję dopasowaną do Twoich
        potrzeb.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={telHref()}
          class="rounded-2xl bg-cta px-5 py-3 font-bold text-white hover:bg-cta-dark"
        >
          Zadzwoń
        </a>
        <a
          href={asset('/kosze-prezentowe')}
          class="rounded-2xl bg-white/15 px-5 py-3 font-bold text-white ring-1 ring-white/30 hover:bg-white/25"
        >
          Zobacz kosze
        </a>
      </div>
    </div>
  </Section>
</BaseLayout>
