---
import { site, telHref } from '../lib/site';
---

<div
  class="fixed inset-x-0 bottom-0 z-50 border-t border-brand/10 bg-white/95 p-2 shadow-lg backdrop-blur md:hidden"
  role="region"
  aria-label="Szybki kontakt"
>
  <div class="mx-auto max-w-lg">
    <a
      href={telHref()}
      class="flex w-full items-center justify-center gap-2 rounded-xl bg-cta py-3 text-sm font-bold text-white"
    >
      📞 Zadzwoń: {site.phoneDisplay}
    </a>
  </div>
</div>
