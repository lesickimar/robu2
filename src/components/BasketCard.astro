---
import type { Basket } from '../lib/site';
import { telHref, asset } from '../lib/site';

interface Props {
  basket: Basket & { badge?: string };
}

const { basket } = Astro.props;
---

<article class="group relative overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-brand/5">
  <div class="aspect-[4/3] w-full overflow-hidden bg-[#f5f0e8]">
    {
      basket.image ? (
        <img
          src={asset(basket.image)}
          alt={basket.title}
          class="h-full w-full object-cover object-center transition duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full items-center justify-center px-4 text-center text-sm font-semibold text-brand/70">
          {basket.title}
        </div>
      )
    }
  </div>
  <a
    href={telHref()}
    class="absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-brand/85 px-5 py-1.5 text-xs font-bold text-white shadow ring-1 ring-white/20 backdrop-blur transition-opacity duration-200 opacity-100 md:opacity-0 md:group-hover:opacity-100"
    aria-label={`Zapytaj o: ${basket.title}`}
  >
    Zapytaj
  </a>
{
  basket.badge && (
    <span class="absolute right-3 top-3 rounded-full bg-brand/85 px-3 py-1 text-xs font-bold text-white shadow ring-1 ring-white/20 backdrop-blur transition-opacity duration-200 opacity-100 md:opacity-0 md:group-hover:opacity-100">
      {basket.badge}
    </span>
  )
}
</article>
