---
import { site, telHref, asset } from '../lib/site';

const path = Astro.url.pathname;
const links = [
  { href: '/o-nas', label: 'O nas' },
  { href: '/obsluga-firm', label: 'Firmy' },
  { href: '/marki', label: 'Marki' },
  { href: '/kosze-prezentowe', label: 'Kosze' },
  { href: '/paczki-prezentowe', label: 'Paczki' },
  { href: '/kontakt', label: 'Kontakt' },
];

function active(href: string) {
  const base = import.meta.env.BASE_URL || '/';
  const full = asset(href).replace(/\/$/, '') || '/';
  const current = path.replace(/\/$/, '') || '/';
  return current === full || current.startsWith(full + '/');
}
---

<header class="sticky top-0 z-40 border-b border-brand/10 bg-cream/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={asset('/')} class="shrink-0" aria-label="ROBU2 — strona główna">
      <img src={asset('/logo.svg')} alt="ROBU2" class="h-9 w-auto md:h-11" width="200" height="35" />
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Główne">
      {
        links.map((l) => (
          <a
            href={asset(l.href)}
            class:list={[
              'rounded-xl px-3 py-2 text-sm font-semibold transition',
              active(l.href)
                ? 'bg-brand/10 text-brand'
                : 'text-ink/80 hover:bg-brand/5 hover:text-brand',
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <a
        href={telHref()}
        class="ml-2 rounded-xl bg-cta px-4 py-2 text-sm font-bold text-white shadow-sm transition hover:bg-cta-dark"
      >
        {site.phoneDisplay}
      </a>
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <a
        href={telHref()}
        class="rounded-xl bg-cta px-3 py-2 text-sm font-bold text-white"
        aria-label={`Zadzwoń ${site.phoneDisplay}`}
      >
        Zadzwoń
      </a>
      <details id="mobile-nav">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-xl border border-brand/15 bg-white text-brand [&::-webkit-details-marker]:hidden"
          aria-label="Otwórz menu"
        >
          <span class="mobile-nav__open text-lg leading-none" aria-hidden="true">☰</span>
          <span class="mobile-nav__close text-lg leading-none" aria-hidden="true">✕</span>
        </summary>
        <nav
          class="absolute inset-x-0 top-full bg-cream p-2 shadow-lg"
          aria-label="Mobilne"
        >
          {
            links.map((l) => (
              <a
                href={asset(l.href)}
                class:list={[
                  'block rounded-xl px-4 py-3 text-base font-semibold',
                  active(l.href)
                    ? 'bg-brand/10 text-brand'
                    : 'text-ink/80 hover:bg-brand/5 hover:text-brand',
                ]}
              >
                {l.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  #mobile-nav .mobile-nav__close {
    display: none;
  }
  #mobile-nav[open] .mobile-nav__open {
    display: none;
  }
  #mobile-nav[open] .mobile-nav__close {
    display: inline;
  }
</style>
