---
import type { Brand } from '../lib/site';

interface Props {
  brands: Brand[];
  limit?: number;
}

const { brands, limit } = Astro.props;
const list = limit ? brands.slice(0, limit) : brands;
---

<ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
  {
    list.map((b) => (
      <li class="flex aspect-[4/3] items-center justify-center rounded-2xl bg-white p-4 shadow-sm ring-1 ring-brand/5 transition hover:shadow-md">
        <img
          src={b.logo}
          alt={b.name}
          class="max-h-12 w-auto max-w-full object-contain"
          loading="lazy"
          width="120"
          height="48"
        />
      </li>
    ))
  }
</ul>
