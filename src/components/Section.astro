---
interface Props {
  id?: string;
  class?: string;
  narrow?: boolean;
}

const { id, class: className = '', narrow = false } = Astro.props;
---

<section id={id} class:list={['py-12 md:py-16', className]}>
  <div class:list={['mx-auto px-4', narrow ? 'max-w-3xl' : 'max-w-6xl']}>
    <slot />
  </div>
</section>
