---
import { site, fullAddress, telHref, asset } from '../lib/site';
---

<footer class="mt-16 border-t border-brand/10 bg-white">
  <div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 md:grid-cols-3">
    <div>
      <img src={asset('/logo.svg')} alt="ROBU2" class="mb-3 h-8 w-auto" width="160" height="28" />
      <p class="text-sm text-muted">{site.tagline}</p>
    </div>
    <div>
      <p class="mb-2 text-sm font-bold text-brand">Kontakt</p>
      <ul class="space-y-1 text-sm text-ink/80">
        <li>
          <a class="hover:text-cta" href={telHref()}>{site.phoneDisplay}</a>
        </li>
        <li>
          <a class="hover:text-cta" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>{fullAddress()}</li>
        <li>NIP {site.nip}</li>
        <li>{site.hours}</li>
      </ul>
    </div>
    <div>
      <p class="mb-2 text-sm font-bold text-brand">Nawigacja</p>
      <ul class="space-y-1 text-sm text-ink/80">
        <li><a class="hover:text-brand" href={asset('/o-nas')}>O nas</a></li>
        <li><a class="hover:text-brand" href={asset('/obsluga-firm')}>Obsługa firm</a></li>
        <li><a class="hover:text-brand" href={asset('/marki')}>Marki</a></li>
        <li><a class="hover:text-brand" href={asset('/kosze-prezentowe')}>Kosze prezentowe</a></li>
        <li><a class="hover:text-brand" href={asset('/paczki-prezentowe')}>Paczki prezentowe</a></li>
        <li><a class="hover:text-brand" href={asset('/kontakt')}>Kontakt</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-brand/5 py-4 text-center text-xs text-muted">
    © {new Date().getFullYear()} {site.name} · NIP {site.nip} · Garwolin
  </div>
</footer>
